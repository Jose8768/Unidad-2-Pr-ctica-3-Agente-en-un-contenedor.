# Plantilla para entregar el token de Google a Docker de forma segura
# IMPORTANTE: Todo el JSON debe ir en una sola línea inmediatamente después del signo igual.
GOOGLE_TOKEN_JSON={"token": "PEGA_AQUI_TU_ACCESS_TOKEN", "refresh_token": "PEGA_AQUI_TU_REFRESH_TOKEN", "token_uri": "https://oauth2.googleapis.com/token", "client_id": "TU_CLIENT_ID", "client_secret": "TU_CLIENT_SECRET", "scopes": ["https://www.googleapis.com/auth/spreadsheets", "https://www.googleapis.com/auth/drive"], "universe_domain": "googleapis.com", "account": "", "expiry": "2026-10-30T00:00:00Z"}
